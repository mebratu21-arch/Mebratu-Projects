{
  "name": "secure-todo-app",
  "version": "1.0.0",
  "description": "Production-ready full-stack secure To-Do List application",
  "private": true,
  "scripts": {
    "install:all": "cd server && npm install && cd ../client && npm install",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "build": "npm run build:server && npm run build:client",
    "test": "cd server && npm test",
    "migrate": "cd server && npm run migrate",
    "migrate:rollback": "cd server && npm run migrate:rollback",
    "seed": "cd server && npm run seed",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": ["todo", "fullstack", "typescript", "react", "express", "postgresql"],
  "author": "",
  "license": "MIT"
}
